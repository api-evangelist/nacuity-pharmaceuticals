        {
          "id": "1f0d1609-d36e-4045-8bf9-5687a67bb95e",
          "name": "Get a page",
          "request": {
            "name": "Get a page",
            "description": {
              "content": "Returns one page. IMPORTANT: on this deployment `content.rendered` and `excerpt.rendered` are EMPTY STRINGS for all 29 published pages — the page bodies are authored in Slider Revolution / page-builder post meta that WordPress does not project into the REST content field, so the body text is only reachable by rendering the HTML page. What the API does return per page is the identity and navigation metadata (id, slug, title, link, date, modified, parent, menu_order, template, class_list) plus the Yoast `yoast_head` markup and `yoast_head_json` object, which carries the canonical URL, robots directives, Open Graph tags and the schema.org @graph (WebPage, BreadcrumbList, WebSite, Organization).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wp",
                "v2",
                "pages",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
